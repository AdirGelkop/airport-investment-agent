# Copy this file to .env and fill in your keys. .env is git-ignored.

# --- LLM (any OpenAI-compatible endpoint) ---
# Groq (default, free tier): https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Alternative - Gemini via its OpenAI-compatible endpoint:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=<a Gemini Flash model id listed in AI Studio>

# --- OpenSky Network (optional; only for live route-distance questions) ---
# Account page -> API client -> copy clientId / clientSecret from credentials.json
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Used automatically if the main model hits the free-tier rate limit (separate quota per model)
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
